{
  "expo": {
    "name": "Tyre Rescue Stock",
    "slug": "tyre-rescue-stock",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "tyrerescuestock",
    "userInterfaceStyle": "dark",
    "icon": "./assets/logo.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "uk.tyrerescue.stock",
      "buildNumber": "3",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "uk.tyrerescue.stock",
      "permissions": [
        "INTERNET"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#0B1117"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/logo.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#0B1117"
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "13b7edcf-8575-4e20-940a-86c3bbc2cf86"
      }
    },
    "owner": "ahmadawadalwakai"
  }
}
