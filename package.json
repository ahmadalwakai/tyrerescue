{
  "name": "tyrerescue",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "check:node": "node scripts/check-node-runtime.mjs",
    "predev": "npm run check:node",
    "prebuild": "npm run check:node",
    "prestart": "npm run check:node",
    "dev": "node --dns-result-order=ipv4first node_modules/next/dist/bin/next dev -p 3002",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:payroll-db": "vitest run --config vitest.payroll-db.config.ts",
    "test:tax-payroll": "vitest run --config vitest.tax-payroll.config.ts",
    "typecheck:tax-payroll": "tsc --noEmit -p tsconfig.tax-payroll.json",
    "test:watch": "vitest",
    "db:push": "dotenv -e .env.local -- drizzle-kit push",
    "db:generate": "dotenv -e .env.local -- drizzle-kit generate",
    "db:migrate": "dotenv -e .env.local -- drizzle-kit migrate",
    "db:baseline": "dotenv -e .env.local -- node scripts/db-baseline-migrations.cjs",
    "db:studio": "dotenv -e .env.local -- drizzle-kit studio",
    "db:seed": "dotenv -e .env.local -- tsx seed.ts",
    "seed:tyres": "dotenv -e .env.local -- tsx scripts/seed-tyres.ts",
    "seed:areas": "dotenv -e .env.local -- tsx scripts/seed-service-areas.ts",
    "seed:cookies": "dotenv -e .env.local -- tsx scripts/seed-cookie-settings.ts",
    "seed:stock": "dotenv -e .env.local -- tsx scripts/seed-from-excel.ts",
    "seed:hero": "dotenv -e .env.local -- tsx scripts/seed-hero-media.ts",
    "appstore:screenshots": "tsx scripts/app-store-screenshots/generate.ts",
    "audit:b2b-leak": "dotenv -e .env.local -- tsx scripts/audit-b2b-reservation-leak.ts",
    "analytics:backfill-keywords": "dotenv -e .env.local -- tsx scripts/backfill-search-keywords.ts",
    "admin:list": "dotenv -e .env.local -- tsx scripts/admin-user.ts --list",
    "admin:create": "dotenv -e .env.local -- tsx scripts/admin-user.ts"
  },
  "dependencies": {
    "@chakra-ui/react": "^3.34.0",
    "@emotion/react": "^11.14.0",
    "@neondatabase/serverless": "^1.0.2",
    "@stripe/react-stripe-js": "^5.6.1",
    "@stripe/stripe-js": "^8.9.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.4",
    "@vercel/blob": "^2.3.1",
    "barcode-detector": "^3.1.1",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.2.0",
    "date-fns": "^4.1.0",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "^0.45.4",
    "googleapis": "^171.4.0",
    "groq-sdk": "^1.1.1",
    "jose": "^6.2.3",
    "jsonwebtoken": "^9.0.3",
    "mapbox-gl": "^3.20.0",
    "motion": "^12.38.0",
    "next": "^16.4.3",
    "next-auth": "^5.0.0-beta.32",
    "pdf-lib": "^1.17.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.0",
    "stripe": "^20.4.1",
    "twilio": "^6.1.0",
    "uuid": "^13.0.2",
    "web-push": "^3.6.7",
    "ws": "^8.22.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/mapbox-gl": "^3.4.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.30.0",
    "eslint": "^9",
    "eslint-config-next": "^16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.0"
  },
  "description": "This is a [Next.js](https://nextjs.org) project bootstrapped with [`create-next-app`](https://nextjs.org/docs/app/api-reference/cli/create-next-app).",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "lib": "lib"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahmadalwakai/tyrerescue.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/ahmadalwakai/tyrerescue/issues"
  },
  "homepage": "https://github.com/ahmadalwakai/tyrerescue#readme"
}
